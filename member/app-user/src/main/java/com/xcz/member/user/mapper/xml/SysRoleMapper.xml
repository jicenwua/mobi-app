<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xcz.member.user.mapper.SysRoleMapper">

    <resultMap id="SysRoleResult" type="com.xcz.member.user.domain.SysRole">
        <id property="roleId" column="role_id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleKey" column="role_key"/>
        <result property="roleSort" column="role_sort"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <insert id="insertUserRole">
        INSERT  INTO sys_user_role (user_id, role_id) VALUES
        <foreach item="item" index="index" collection="roleIds" separator=",">
            (#{userId}, #{item})
        </foreach>
    </insert>
    <insert id="insertRoleMenu">
        INSERT INTO sys_role_menu (role_id, menu_id) VALUES
        <foreach item="item" index="index" collection="menuIds" separator=",">
            (#{roleId}, #{item})
        </foreach>
    </insert>

    <delete id="deleteUserRole">
        DELETE FROM sys_user_role WHERE user_id = #{userId}
    </delete>
    <delete id="deleteRoleMenu">
        DELETE FROM sys_role_menu WHERE role_id = #{roleId}
    </delete>
    <delete id="deleteUserRoleByRoles">
        DELETE FROM sys_user_role WHERE role_id IN
        <foreach item="item" index="index" collection="roleIds" separator=",">
            #{item}
        </foreach>
    </delete>

    <select id="selectRolesByMenuIds" resultMap="SysRoleResult">
        SELECT DISTINCT r.*
        FROM sys_role r
        INNER JOIN sys_role_menu rm ON r.role_id = rm.role_id
        WHERE r.del_flag = 0
          AND rm.menu_id IN
        <foreach item="item" collection="menuIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="selectUserIdsByRoleIds" resultType="java.lang.Long">
        SELECT DISTINCT ur.user_id
        FROM sys_user_role ur
        INNER JOIN sys_role r ON r.role_id = ur.role_id AND r.del_flag = 0
        WHERE ur.role_id IN
        <foreach item="item" collection="roleIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <select id="selectRoleKeysByUserIds" resultType="com.xcz.member.user.domain.dto.UserRoleKeyDTO">
        SELECT ur.user_id AS userId, r.role_key AS roleKey
        FROM sys_user_role ur
        INNER JOIN sys_role r ON r.role_id = ur.role_id AND r.del_flag = 0 AND r.status = '0'
        WHERE ur.user_id IN
        <foreach item="item" collection="userIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>

    <update id="deleteRoles">
        UPDATE sys_role r
        SET r.del_flag = 1, r.update_by = #{userId}, r.update_time = NOW()
        WHERE r.role_id IN
        <foreach item="item" index="index" collection="roleIds" separator=",">
            #{item}
        </foreach>
    </update>

    <select id="selectRolesByUserId" resultMap="SysRoleResult">
        SELECT r.* FROM sys_role r
        LEFT JOIN sys_user_role ur ON r.role_id = ur.role_id
        WHERE ur.user_id = #{userId} AND r.del_flag = 0 AND r.status = '0'
    </select>
    <select id="selectRoleInfos" resultType="com.xcz.member.user.domain.vo.RoleMenuVO">
        SELECT
            r.role_id,
            r.role_name,
            r.role_key,
            r.status,
            r.role_sort,
            r.create_by,
            r.create_time,
            r.update_by,
            r.update_time,
            r.remark,
            GROUP_CONCAT(sm.menu_id) as menuIdsStr
        FROM sys_role r
        LEFT JOIN sys_role_menu stm on r.role_id = stm.role_id
        LEFT JOIN sys_menu sm on stm.menu_id = sm.menu_id
        WHERE r.del_flag = 0
            <if test="roleDto.roleName != null and roleDto.roleName != ''">
                AND r.role_name LIKE concat('%', #{roleDto.roleName}, '%')
            </if>
            <if test="roleDto.roleKey != null and roleDto.roleKey != ''">
                AND r.role_key LIKE concat('%', #{roleDto.roleKey}, '%')
            </if>
            <if test="roleDto.status != null and roleDto.status != ''">
                AND r.status = #{roleDto.status}
            </if>
        GROUP BY r.role_id
    </select>

</mapper>
