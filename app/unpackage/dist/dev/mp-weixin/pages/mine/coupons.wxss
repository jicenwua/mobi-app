
.page.data-v-aa0a0a80 {
	min-height: 100vh;
	background: #f5f5f5;
	display: flex;
	flex-direction: column;
}
.tab-bar.data-v-aa0a0a80 {
	display: flex;
	position: relative;
	margin: 12px 16px 0;
	background: #e8e8e8;
	border-radius: 8px;
	padding: 3px;
	flex-shrink: 0;
}
.tab-item.data-v-aa0a0a80 {
	flex: 1;
	z-index: 1;
	padding: 8px 0;
	text-align: center;
}
.tab-text.data-v-aa0a0a80 {
	font-size: 14px;
	color: #666;
}
.tab-item.active .tab-text.data-v-aa0a0a80 {
	color: #fff;
	font-weight: 600;
}
.tab-slider.data-v-aa0a0a80 {
	position: absolute;
	top: 3px;
	left: 3px;
	height: calc(100% - 6px);
	background: #007aff;
	border-radius: 6px;
	transition: transform 0.25s ease;
}
.scroll.data-v-aa0a0a80 {
	flex: 1;
	height: 0;
	padding: 12px 16px 16px;
	box-sizing: border-box;
}
.coupon-card.data-v-aa0a0a80 {
	display: flex;
	align-items: flex-start;
	gap: 12px;
	background: #fff;
	border-radius: 10px;
	padding: 14px;
	margin-bottom: 10px;
	box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}
.coupon-card--muted.data-v-aa0a0a80 {
	opacity: 0.72;
}
.coupon-icon.data-v-aa0a0a80 {
	width: 44px;
	height: 44px;
	flex-shrink: 0;
}
.coupon-body.data-v-aa0a0a80 {
	flex: 1;
	min-width: 0;
}
.coupon-head.data-v-aa0a0a80 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-bottom: 4px;
}
.coupon-name.data-v-aa0a0a80 {
	font-size: 15px;
	font-weight: 600;
	color: #222;
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.coupon-type.data-v-aa0a0a80 {
	font-size: 11px;
	color: #007aff;
	background: rgba(0, 122, 255, 0.1);
	padding: 2px 6px;
	border-radius: 4px;
	flex-shrink: 0;
}
.coupon-desc.data-v-aa0a0a80 {
	display: block;
	font-size: 13px;
	color: #e65c00;
	margin-bottom: 4px;
}
.coupon-shop.data-v-aa0a0a80 {
	display: block;
	font-size: 12px;
	color: #666;
	margin-bottom: 2px;
}
.coupon-time.data-v-aa0a0a80 {
	display: block;
	font-size: 12px;
	color: #666666;
}
.state-wrap.data-v-aa0a0a80 {
	padding: 48px 0;
	text-align: center;
}
.state-wrap--inline.data-v-aa0a0a80 {
	padding: 16px 0;
}
.state-text.data-v-aa0a0a80 {
	font-size: 14px;
	color: #666666;
}
