
.page.data-v-6ca6b674 {
	min-height: 100vh;
	padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
	box-sizing: border-box;
	background: #f5f5f5;
}
.page--with-refund.data-v-6ca6b674 {
	padding-bottom: calc(80px + env(safe-area-inset-bottom));
}
.page--dark.data-v-6ca6b674 {
	background: #121212;
	color: #e8e8e8;
}
.detail-head.data-v-6ca6b674 {
	padding: 8px 0 16px;
	text-align: center;
}
.detail-title.data-v-6ca6b674 {
	display: block;
	font-size: 20px;
	font-weight: 700;
	margin-bottom: 6px;
}
.detail-status.data-v-6ca6b674 {
	display: block;
	font-size: 14px;
	color: #007aff;
	font-weight: 600;
}
.page--dark .detail-status.data-v-6ca6b674 {
	color: #5ac8fa;
}
.detail-status--muted.data-v-6ca6b674 {
	color: #888 !important;
}
.detail-sub.data-v-6ca6b674 {
	display: block;
	margin-top: 8px;
	font-size: 13px;
	opacity: 0.55;
}
.section-card.data-v-6ca6b674 {
	background: #fff;
	border-radius: 12px;
	padding: 14px 16px;
	margin-bottom: 12px;
}
.page--dark .section-card.data-v-6ca6b674 {
	background: #1e1e1e;
}
.summary-row.data-v-6ca6b674 {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	padding: 8px 0;
	font-size: 14px;
	border-bottom: 1px solid rgba(128, 128, 128, 0.12);
}
.summary-row.data-v-6ca6b674:last-of-type {
	border-bottom: none;
}
.summary-label.data-v-6ca6b674 {
	opacity: 0.55;
	flex-shrink: 0;
	margin-right: 12px;
}
.summary-value.data-v-6ca6b674 {
	text-align: right;
	flex: 1;
}
.summary-value--gain.data-v-6ca6b674 {
	color: #34c759;
	font-weight: 600;
}
.summary-value--points.data-v-6ca6b674 {
	color: #ff3b30;
	font-weight: 600;
}
.page--dark .summary-value--points.data-v-6ca6b674 {
	color: #ff6b6b;
}
.goods-block.data-v-6ca6b674 {
	margin-top: 12px;
	padding-top: 12px;
	border-top: 1px solid rgba(128, 128, 128, 0.12);
}
.goods-title.data-v-6ca6b674 {
	display: block;
	font-size: 14px;
	font-weight: 600;
	margin-bottom: 8px;
}
.goods-row.data-v-6ca6b674 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 6px 0;
	font-size: 13px;
}
.goods-name-wrap.data-v-6ca6b674 {
	flex: 1;
	display: flex;
	align-items: center;
	gap: 6px;
}
.goods-count.data-v-6ca6b674 {
	opacity: 0.55;
}
.goods-empty.data-v-6ca6b674,
.goods-loading.data-v-6ca6b674 {
	padding: 12px 0;
	text-align: center;
}
.goods-empty-text.data-v-6ca6b674 {
	font-size: 13px;
	opacity: 0.45;
}
.state-wrap.data-v-6ca6b674 {
	padding: 48px 16px;
	text-align: center;
}
.state-text.data-v-6ca6b674 {
	font-size: 14px;
	opacity: 0.55;
}
.qr-card.data-v-6ca6b674 {
	text-align: center;
}
.qr-title.data-v-6ca6b674 {
	display: block;
	font-size: 15px;
	font-weight: 600;
	margin-bottom: 12px;
}
.qr-wrap.data-v-6ca6b674 {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 10px;
}
.qr-hint.data-v-6ca6b674 {
	font-size: 12px;
	opacity: 0.55;
}
.qr-error-text.data-v-6ca6b674 {
	font-size: 13px;
	color: #ff3b30;
}
.refund-bar.data-v-6ca6b674 {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
	background: rgba(255, 255, 255, 0.96);
	box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}
.page--dark .refund-bar.data-v-6ca6b674 {
	background: rgba(30, 30, 30, 0.96);
}
.refund-btn.data-v-6ca6b674 {
	width: 100%;
	height: 44px;
	line-height: 44px;
	border-radius: 10px;
	background: #ff3b30;
	color: #fff;
	font-size: 16px;
	border: none;
}
.refund-btn--loading.data-v-6ca6b674 {
	opacity: 0.7;
}
