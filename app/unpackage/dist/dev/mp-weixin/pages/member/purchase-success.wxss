
.page.data-v-22ccdaa7 {
	min-height: 100vh;
	padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
	box-sizing: border-box;
	background: #f5f5f5;
}
.page--dark.data-v-22ccdaa7 {
	background: #121212;
	color: #e8e8e8;
}
.success-head.data-v-22ccdaa7 {
	padding: 24px 0 16px;
	text-align: center;
}
.success-icon.data-v-22ccdaa7 {
	width: 56px;
	height: 56px;
	margin: 0 auto 12px;
	border-radius: 28px;
	background: linear-gradient(135deg, #34c759, #30b350);
	color: #fff;
	font-size: 28px;
	line-height: 56px;
	font-weight: 700;
}
.success-title.data-v-22ccdaa7 {
	display: block;
	font-size: 20px;
	font-weight: 700;
	margin-bottom: 6px;
}
.success-sub.data-v-22ccdaa7 {
	display: block;
	font-size: 13px;
	opacity: 0.55;
}
.section-card.data-v-22ccdaa7 {
	background: #fff;
	border-radius: 12px;
	padding: 14px 16px;
	margin-bottom: 12px;
}
.page--dark .section-card.data-v-22ccdaa7 {
	background: #1e1e1e;
}
.summary-row.data-v-22ccdaa7 {
	display: flex;
	justify-content: space-between;
	gap: 12px;
	padding: 8px 0;
	font-size: 14px;
}
.summary-label.data-v-22ccdaa7 {
	opacity: 0.6;
}
.summary-value--points.data-v-22ccdaa7 {
	color: #e64340;
	font-weight: 600;
}
.goods-block.data-v-22ccdaa7 {
	margin-top: 8px;
	padding-top: 10px;
	border-top: 1px solid rgba(128, 128, 128, 0.15);
}
.goods-title.data-v-22ccdaa7 {
	display: block;
	font-size: 13px;
	font-weight: 600;
	margin-bottom: 8px;
}
.goods-row.data-v-22ccdaa7 {
	display: flex;
	justify-content: space-between;
	padding: 4px 0;
	font-size: 13px;
}
.goods-name.data-v-22ccdaa7 {
	flex: 1;
	min-width: 0;
}
.goods-meta.data-v-22ccdaa7 {
	opacity: 0.55;
	margin-left: 8px;
}
.actions.data-v-22ccdaa7 {
	margin-top: 8px;
	display: flex;
	flex-direction: column;
	gap: 10px;
}
.action-btn.data-v-22ccdaa7 {
	padding: 12px;
	border-radius: 10px;
	text-align: center;
	background: #fff;
}
.page--dark .action-btn.data-v-22ccdaa7 {
	background: #1e1e1e;
}
.action-btn--primary.data-v-22ccdaa7 {
	background: linear-gradient(135deg, #ffc107, #ff9800);
}
.action-btn-text.data-v-22ccdaa7 {
	font-size: 15px;
	font-weight: 600;
	color: #fff;
}
.action-btn-text--muted.data-v-22ccdaa7 {
	color: #666;
}
.page--dark .action-btn-text--muted.data-v-22ccdaa7 {
	color: #ccc;
}
.state-wrap.data-v-22ccdaa7 {
	padding: 48px 16px;
	text-align: center;
}
.state-text.data-v-22ccdaa7 {
	font-size: 14px;
	opacity: 0.5;
}
