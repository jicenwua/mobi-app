text class="form-date-sep data-v-808d8eeb">至</text><picker class="data-v-808d8eeb" mode="date" value="{{t}}" bindchange="{{v}}"><view class="form-date-cell data-v-808d8eeb"><text class="form-date-tag data-v-808d8eeb">结束</text><text class="{{['form-date-val', 'data-v-808d8eeb', s && 'form-date-val--empty']}}">{{r}}</text></view></picker></view><view wx:if="{{w}}" class="form-date-actions data-v-808d8eeb"><text wx:if="{{x}}" class="form-date-clear data-v-808d8eeb" bindtap="{{y}}">清空开始</text><text wx:if="{{z}}" class="form-date-clear data-v-808d8eeb" bindtap="{{A}}">清空结束</text></view></view></view><view wx:if="{{B}}" class="form-block data-v-808d8eeb"><view class="form-block-head data-v-808d8eeb"><text class="form-block-title form-block-title--inline data-v-808d8eeb">满赠规则</text><view class="form-block-add data-v-808d8eeb" bindtap="{{C}}"><text class="form-block-add-text data-v-808d8eeb">+ 添加规则</text></view></view><view wx:if="{{D}}" class="rule-empty data-v-808d8eeb"><text class="rule-empty-icon data-v-808d8eeb">🎁</text><text class="rule-empty-text data-v-808d8eeb">暂无规则，点击右上角添加</text></view><view wx:else class="rule-list data-v-808d8eeb"><view wx:for="{{E}}" wx:for-item="rule" wx:key="g" class="rule-card data-v-808d8eeb"><view class="rule-card-head data-v-808d8eeb"><text class="rule-card-index data-v-808d8eeb">规则 {{rule.a}}</text><text wx:if="{{F}}" class="rule-card-del data-v-808d8eeb" bindtap="{{rule.b}}">删除</text></view><view class="rule-card-body data-v-808d8eeb"><view class="rule-input-group data-v-808d8eeb"><text class="rule-input-label data-v-808d8eeb">满</text><view class="rule-input-wrap data-v-808d8eeb"><input class="rule-input data-v-808d8eeb" type="number" placeholder="100" placeholder-class="form-placeholder" value="{{rule.c}}" bindinput="{{rule.d}}"/><text class="rule-input-suffix data-v-808d8eeb">积分</text></view></view><text class="rule-arrow data-v-808d8eeb">→</text><view class="rule-input-group data-v-808d8eeb"><text class="rule-input-label data-v-808d8